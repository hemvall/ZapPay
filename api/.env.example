# Example environment for the API server
PORT=4010

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Frontend URL (used for payment links and QR codes)
FRONTEND_URL=http://localhost:5173

# === Blockchain RPCs ===
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# === ZapPay Treasury ===
ZAPPAY_TREASURY_ADDRESS=0x...

# === Splitter Contract (if using Option B for fees) ===
ZAPPAY_ROUTER_ADDRESS_ETHEREUM=
ZAPPAY_ROUTER_ADDRESS_BASE=

# === Payment Config ===
PAYMENT_TTL_MINUTES=30
CONFIRMATION_COUNT_ETHEREUM=2
CONFIRMATION_COUNT_BASE=1
