generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PENDING
  CONFIRMING
  CONFIRMED
  FAILED
  EXPIRED
  UNDERPAID
}

enum TokenSymbol {
  USDC
  USDT
  ETH
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  EXHAUSTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Merchant {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  apiKeyHash   String  @unique
  apiKeyPrefix String
  webhookUrl   String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments          Payment[]
  webhookDeliveries WebhookDelivery[]

  @@index([apiKeyHash])
  @@map("merchants")
}

model Payment {
  id                    String        @id @default(cuid())
  merchantId            String
  status                PaymentStatus @default(CREATED)
  amountRequested       Decimal       @db.Decimal(36, 18)
  amountReceived        Decimal?      @db.Decimal(36, 18)
  currency              TokenSymbol
  chainId               Int
  paymentAddress        String
  txHash                String?
  blockNumber           BigInt?
  confirmations         Int           @default(0)
  confirmationsRequired Int           @default(12)
  expiresAt             DateTime
  confirmedAt           DateTime?
  webhookUrl            String?
  metadata              Json          @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  events            PaymentEvent[]
  webhookDeliveries WebhookDelivery[]
  feeEstimates      FeeEstimate[]

  @@index([merchantId])
  @@index([status])
  @@index([paymentAddress])
  @@index([txHash])
  @@index([expiresAt, status])
  @@index([chainId, status])
  @@map("payments")
}

model PaymentEvent {
  id          String        @id @default(cuid())
  paymentId   String
  eventType   String
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus?
  payload     Json          @default("{}")
  createdAt   DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([eventType])
  @@map("payment_events")
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  merchantId   String
  paymentId    String
  url          String
  status       WebhookDeliveryStatus @default(PENDING)
  attemptCount Int                   @default(0)
  maxAttempts  Int                   @default(5)
  nextRetryAt  DateTime?
  lastHttpCode Int?
  lastError    String?
  payload      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model FeeEstimate {
  id             String      @id @default(cuid())
  paymentId      String
  chainId        Int
  currency       TokenSymbol
  gasPriceGwei   String
  estimatedGas   BigInt
  totalFeeNative String
  totalFeeUsd    String?
  confidence     String

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("fee_estimates")
}
